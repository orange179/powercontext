{
  "name": "seekdb-stepfun-onside-kb",
  "private": true,
  "version": "1.0.0",
  "description": "On-device embedding + seekdb hybrid retrieval mini knowledge base (seekdb x StepFun competition)",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-ort.mjs",
    "predev": "node scripts/copy-ort.mjs",
    "prebuild": "node scripts/copy-ort.mjs",
    "dev": "node server/index.mjs --dev",
    "build": "vite build",
    "start": "node server/index.mjs",
    "typecheck": "tsc --noEmit",
    "fetch:models": "node scripts/fetch-models.mjs",
    "eval:quality": "node scripts/eval-quality.mjs",
    "preview": "npm run build && node server/index.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "express": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "seekdb": "1.4.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.3"
  },
  "engines": {
    "node": ">=20"
  }
}
